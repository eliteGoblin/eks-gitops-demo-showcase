    "realm": [
      {
        "name": "participant",
        "description": "A person who holds a support plan"
      },
      {
        "name": "nominee",
        "description": "Acts for a participant under an active delegation"
      },
      {
        "name": "provider",
        "description": "Provider staff; linked to a provider via provider_id"
      },
      {
        "name": "agency_staff",
        "description": "Agency staff; may read everything (audited) and approve claims"
      }
    ],
    "client": {
      "payments-svc": [
        {
          "name": "payments:write",
          "description": "Create payments (demo-api's service account)"
        },
        {
          "name": "payments:read",
          "description": "Read payments"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "argocd-admins",
